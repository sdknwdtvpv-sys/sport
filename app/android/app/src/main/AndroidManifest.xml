<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 埋点上报需要联网。Flutter 模板只在 debug/profile 变体里加 INTERNET（为了热重载），
         所以 release 版原本**没有**这个权限 —— 一旦接上真实上报地址，release 会静默失败
         （OutboxAnalytics.track() 刻意绝不抛异常，所以不会有任何报错）。
         这里显式声明到 main，让三个变体行为一致。

         本应用是离线优先：训练记录只存在本机 SQLite，不联网也能完整使用；
         联网仅用于「帮助改进产品」开关打开时的匿名埋点上报。

         若某版本决定不做任何上报，可删掉这一行以收紧权限。 -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 存分享卡到相册（gal 的 README 明确要求这一条）。
         用 maxSdkVersion 把范围限死在 API ≤ 29：
           * API 30+ 走 MediaStore，**不需要任何权限**，新系统上根本看不到这条
           * API ≤ 29 的老设备才需要它
         加上 INTERNET 与下面的通知权限，release 版一共只声明**三条**权限
         （这条注释以前写的是"两条"—— 加 POST_NOTIFICATIONS 那次没跟着改；
         `app/test/reminder_test.dart` 现在把这三项逐个钉住了）。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
                     android:maxSdkVersion="29" />

    <!-- 训练提醒（本地通知）。API 33+ 这是**运行时**权限：只在用户主动打开
         「训练提醒」开关时才向他请求，不在启动时要 —— 政策 §2.1 与隐私事实表都这么写。
         低于 33 的系统没有这个权限（装了就等于允许）。

         ⚠️ 这个开关**不联网、也不排精确闹钟**：提醒由系统在本机到点触发
         （`setAndAllowWhileIdle`，非精确，因此不需要 SCHEDULE_EXACT_ALARM 那个特殊权限），
         内容在排程时就算好塞进 Intent 里，服务端不知道你几点该练。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <!-- **锁竖屏**（2026-09-30 实测后定的）：横屏下首页那条大按钮所在的 Column
             会 RenderFlex overflow（现场日志："BOTTOM OVERFLOWED BY 80 PIXELS"），
             入口文字还会与底部导航撞在一起。我们一个横屏设计都没有 —— 与其留着
             "转一下就坏"的状态，不如明确只支持竖屏。实测记录见 docs/release-admin.md §二之四。
             ⚠️ 这条注释必须在 <activity> **外面**：XML 不允许把注释塞在开始标签的属性之间，
             第一版就是那么写的，结果 aapt2 直接报 "not a valid XML document"。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 训练提醒到点时由它发通知（不唤醒 App、不读数据库：内容在排程时就写好了） -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
