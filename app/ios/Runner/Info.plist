<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<!-- 桌面上的名字。模板留的是 Lianleme，与商店名/安卓名不一致 —— 三处必须同名。 -->
	<string>练了么</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>lianleme</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Live Activity（组间休息）：没有这一位，Activity.request 会直接抛错 -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- **手机只支持竖屏**（2026-09-30 实测：横屏下首页会 layout overflow，
	     入口文字与底部导航重叠）。与安卓那边的 android:screenOrientation="portrait"
	     是同一个决定、同一份证据（docs/release-admin.md §二之四）。
	     模板原本给了三个方向（竖屏 + 左右横屏），我们一个横屏设计都没有。 -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- 存分享卡到相册（gal 插件）。**只声明"仅新增"，不申请读取相册** ——
	     多要一项权限就等于多要一分信任，而我们并不需要读用户的相册。
	     安卓那边走 MediaStore 免权限，所以这个键只在 iOS 需要。

	     ⚠️ 这里**故意没有** NSPhotoLibraryUsageDescription（读相册权限），
	     而这是一个会咬人的决定：gal 建/找相簿要读相册
	     （PHAssetCollection.fetchAssetCollections + creationRequestForAssetCollection，
	     需要 .readWrite 授权），所以 **iOS 上不能带相簿名去存**。
	     对应代码是 app/lib/features/summary/share_card_exporter.dart 的
	     shareAlbumNameFor(isIOS:) —— iOS 传 null，卡片落进「最近项目」。
	     代价是少一个相簿分组，换来的是政策里那句"从不读取你的相册"为真。
	     tool/asset-check.mjs 有一条跨文件检查守着这两者的互斥关系：一旦有人
	     把 album: kShareAlbumName 写回代码，门禁就红。 -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>把训练总结卡片存进你的相册。我们只写入这一张图，不会读取你相册里的任何内容。</string>
	<!-- 从系统健康库读体成分（2026-10-09）。
	     ⚠️ 只有"读"这一句 —— **故意不写 NSHealthUpdateUsageDescription**：
	     我们一个字都不写回健康库（代码里是 requestAuthorization(toShare: [])），
	     写了那一句等于向用户申请一件我们不做的事。
	     这句话会在系统授权弹窗里原样显示给用户，所以它必须与政策正文同一个口径：
	     只读体重/体脂率/身高、只在本机、默认关、随时可撤（见 docs/privacy-policy.md 那一节）。 -->
	<key>NSHealthShareUsageDescription</key>
	<string>读取你健康里的体重、体脂率和身高，用来给「身体数据」页补上你自己没记的那些天。只读不写，数据只留在这台手机上，随时可以关掉。</string>
	<!-- App Store 的加密合规问题：只用了系统标准的 HTTPS，属于豁免范围，声明 false
	     即可，否则每次提审都要回答出口合规问卷。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- 本 App 只有深色主题（与安卓的 NormalTheme 一致）。不锁的话，系统处于浅色模式时
	     状态栏/系统控件会按浅色渲染，与页面撞色。 -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
