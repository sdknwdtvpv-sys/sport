[Unit]
Description=练了么 · 极薄后端（账号 / 备份 / 删除，只存密文）
Documentation=file://__APP_DIR__/server/backend.mjs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__APP_DIR__
# 只监听本机：对外只有 Caddy 一个入口（端口不暴露到公网）
ExecStart=__NODE__ __APP_DIR__/server/backend.mjs --port __BACKEND_PORT__ --db __DATA_DIR__/backend.sqlite
Restart=always
RestartSec=3

# ── 账号体系的密钥与邮件口令 ─────────────────────────────────────────
# ⚠️ 这些**故意不写在这份单元文件里**（`install.sh` 的 render() 会把值 sed 进单元文件，
# 而 systemd 单元是 644、会被 --dry-run 打到终端、还会进 shell 历史）——
# 口令走这个 root 0600 的 EnvironmentFile，由 install.sh 建好空模板、你手工填。
# 前缀 `-` = 文件不存在也不阻止启动（没配就没有账号体系，备份那条路照常）。
# 变量名（代码真的会读的那些）：LIANLEME_AUTH_SECRET / LIANLEME_SMTP_HOST / LIANLEME_SMTP_PORT
#   / LIANLEME_SMTP_USER / LIANLEME_SMTP_PASS / LIANLEME_SMTP_FROM
EnvironmentFile=-__MAIL_ENV__

# ── 加固（服务被攻破也走不出去）────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
# ⚠️ **故意没有 `MemoryDenyWriteExecute=true`**（2026-10-04 真机上量到的）：
# V8 的 JIT 需要"可写且可执行"的内存页，开这个开关后 Node **一启动就 SIGTRAP 崩溃**
# （`MemoryAllocator::SetPermissionsOnExecutableMemoryChunk`），systemd 会无限重启 + core dump。
# 这条是这一包第一次面对真 systemd 时才发现的 —— 自检抓不到它，只有真跑一次才知道。
# 其余加固项照旧（它们不影响 Node）。
CapabilityBoundingSet=
# 唯一的可写路径：库文件就在这儿
ReadWritePaths=__DATA_DIR__

[Install]
WantedBy=multi-user.target
